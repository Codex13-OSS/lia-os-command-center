LIA_AGENT_HOST=127.0.0.1
LIA_AGENT_PORT=3014
LIA_AGENT_CORS_ORIGINS=
LIA_AGENT_LOG_LEVEL=info

# Rutas absolutas opcionales. Vacías mantienen cada feature sin configurar.
LIA_AGENDA_SQLITE_PATH=
LIA_PROJECT_TASK_SQLITE_PATH=

# Registro de proyectos autorizados (flujo de proyecto autónomo).
# Sin este archivo, toda tarea de proyecto responde 503 registry_unavailable.
LIA_PROJECT_REGISTRY_PATH=/opt/lia-os-config/projects.json
# Perfil de verificación preautorizada (comprobaciones del proyecto).
# Requerido para tareas con run_tests / local_commit; sin él la etapa de
# verificación falla con verification_unavailable.
LIA_PROJECT_VERIFICATION_PATH=/opt/lia-os-config/project-verification.json

LIA_HERMES_ROOT=/home/hermes-agent/.hermes/hermes-agent
LIA_HERMES_EXECUTION_ENABLED=false
LIA_HERMES_EXECUTABLE=/home/hermes-agent/.local/bin/hermes
LIA_HERMES_HOME=/home/hermes-agent/.hermes
LIA_HERMES_USER=hermes-agent
LIA_HERMES_USER_HOME=/home/hermes-agent
LIA_HERMES_PATH=/home/hermes-agent/.local/bin:/usr/local/bin:/usr/bin:/bin
LIA_HERMES_PROVIDER=openai-codex
LIA_HERMES_MODEL=gpt-5.6-terra
LIA_HERMES_TIMEOUT_MS=120000
LIA_HERMES_MAX_QUERY_CHARACTERS=8000

# Supervisor Scheduling Runtime Wiring: enables exactly one bounded multi-goal
# reconciliation opportunity at startup plus event-driven (terminalization /
# operator) wakeups. Default OFF: the supervisor, like the bounded pass it
# drives, ships inert. The in-memory task store has no goal surface, so this
# only takes effect with LIA_PROJECT_TASK_SQLITE_PATH configured.
LIA_SUPERVISOR_ENABLED=false

# Codex executor provider routing: openai | deepseek | auto (default: auto)
LIA_CODEX_PROVIDER_MODE=auto
# DeepSeek API key referenced by the deepseek/auto Codex provider routing.
# Production reads the secret at runtime from process.env or the protected env
# file (/home/hermes-agent/.hermes/.env) only when DeepSeek is actually invoked.
# The value is never stored in source and is never written to logs or argv.
DEEPSEEK_API_KEY=
